<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.guillermodubon.musicplayer.controllers.ui.screens.searchResultsPage.SearchResultsPageController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="search-results-root"
            stylesheets="@search-results-page.css">

    <top>
        <StackPane styleClass="search-results-header">
            <VBox alignment="CENTER_LEFT"
                  spacing="4"
                  styleClass="search-results-header-content">
                <Label fx:id="titleLabel"
                       wrapText="true"
                       styleClass="search-results-title"/>
            </VBox>
            <Region mouseTransparent="true"
                    styleClass="search-results-header-bottom-fade"
                    StackPane.alignment="BOTTOM_CENTER"/>
            <BorderPane.margin>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </BorderPane.margin>
        </StackPane>
    </top>

    <center>
        <StackPane>
            <ScrollPane fx:id="scrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        pannable="true"
                        styleClass="search-results-scroll">
                <content>
                    <VBox fx:id="contentBox"
                          spacing="16"
                          fillWidth="true"
                          styleClass="search-results-content">
                        <padding>
                            <Insets top="18" right="28" bottom="36" left="28"/>
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
            <VBox fx:id="feedbackBox"
                  alignment="CENTER"
                  managed="false"
                  mouseTransparent="true"
                  spacing="12"
                  visible="false"
                  StackPane.alignment="CENTER"
                  styleClass="search-results-feedback">
                <StackPane fx:id="feedbackIconHost"
                           managed="false"
                           visible="false"
                           styleClass="search-results-feedback-icon"/>
                <Label fx:id="feedbackLabel"
                       maxWidth="560"
                       textAlignment="CENTER"
                       wrapText="true"
                       styleClass="search-results-feedback-message"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
