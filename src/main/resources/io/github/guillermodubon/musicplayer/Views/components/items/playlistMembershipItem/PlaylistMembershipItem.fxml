<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.guillermodubon.musicplayer.controllers.ui.components.items.musicItems.PlaylistMembershipItemController"
      alignment="CENTER_LEFT"
      spacing="12"
      maxWidth="Infinity"
      stylesheets="@playlist-membership-item.css"
      styleClass="playlist-membership-item">

    <ImageView fx:id="coverView"
               fitWidth="42"
               fitHeight="42"
               preserveRatio="false"
               smooth="true"
               styleClass="playlist-membership-cover"/>

    <Label fx:id="titleLabel"
           maxWidth="Infinity"
           HBox.hgrow="ALWAYS"
           textOverrun="ELLIPSIS"
           styleClass="playlist-membership-title"/>

    <CheckBox fx:id="membershipCheckBox"
              focusTraversable="false"
              styleClass="playlist-membership-checkbox"/>
</HBox>
