<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.guillermodubon.musicplayer.controllers.ui.components.dialogs.playlistManagementDialogs.DeletePlaylistDialogController"
            prefWidth="420" prefHeight="240"
            stylesheets="@DeletePlaylistDialog.css"
            styleClass="delete-playlist-dialog-root">

    <fx:include fx:id="shell"
                source="../base/DialogShell.fxml"
                AnchorPane.topAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"/>

    <Button fx:id="closeButton"
            focusTraversable="false"
            onAction="#onCancel"
            styleClass="delete-playlist-close-button"
            AnchorPane.topAnchor="18.0"
            AnchorPane.rightAnchor="20.0"/>
</AnchorPane>
