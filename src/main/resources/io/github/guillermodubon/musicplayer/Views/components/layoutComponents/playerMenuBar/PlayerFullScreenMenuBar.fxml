<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.guillermodubon.musicplayer.controllers.ui.components.layoutComponents.playerMenuBar.PlayerFullScreenMenuBarController"
            minHeight="178"
            maxWidth="Infinity"
            stylesheets="@player-fullscreen-menu-bar.css"
            styleClass="player-fullscreen-menu-bar">
   <center>
      <VBox fx:id="content"
            alignment="CENTER"
            spacing="18"
            maxWidth="Infinity"
            styleClass="player-fullscreen-menu-bar-content">
         <padding>
            <Insets top="10" right="0" bottom="16" left="0"/>
         </padding>

         <HBox fx:id="timeRow"
               alignment="CENTER"
               spacing="12"
               maxWidth="Infinity"
               styleClass="player-fullscreen-time-row">
            <Label fx:id="currentMinuteLabel"
                   minWidth="48"
                   prefWidth="48"
                   alignment="CENTER_RIGHT"
                   text="0:00"
                   styleClass="player-fullscreen-time-label"/>
            <StackPane fx:id="songTimerSliderShell"
                       HBox.hgrow="ALWAYS"
                       minWidth="260"
                       prefWidth="660"
                       maxWidth="900"
                       styleClass="player-fullscreen-slider-shell">
               <Region fx:id="songTimerSliderBase"
                       mouseTransparent="true"
                       StackPane.alignment="CENTER_LEFT"
                       styleClass="player-fullscreen-slider-base"/>
               <Region fx:id="songTimerSliderFill"
                       mouseTransparent="true"
                       StackPane.alignment="CENTER_LEFT"
                       styleClass="player-fullscreen-slider-fill"/>
               <Slider fx:id="songTimerSlider"
                       min="0"
                       max="100"
                       value="0"
                       minWidth="260"
                       prefWidth="660"
                       maxWidth="900"
                       styleClass="player-fullscreen-slider"/>
            </StackPane>
            <Label fx:id="songLengthLabel"
                   minWidth="48"
                   prefWidth="48"
                   alignment="CENTER_LEFT"
                   text="0:00"
                   styleClass="player-fullscreen-time-label"/>
         </HBox>

         <HBox fx:id="transportRow"
               alignment="CENTER"
               spacing="16"
               maxWidth="Infinity"
               styleClass="player-fullscreen-transport-row">
            <ToggleButton fx:id="randomToggleButton"
                          focusTraversable="false"
                          styleClass="player-fullscreen-control-button"/>
            <Button fx:id="previousButton"
                    onAction="#previousSong"
                    focusTraversable="false"
                    styleClass="player-fullscreen-control-button"/>
            <ToggleButton fx:id="playToggleButton"
                          onAction="#playPauseSong"
                          focusTraversable="false"
                          styleClass="player-fullscreen-play-button"/>
            <Button fx:id="nextButton"
                    onAction="#nextSong"
                    focusTraversable="false"
                    styleClass="player-fullscreen-control-button"/>
            <ToggleButton fx:id="replayToggleButton"
                          focusTraversable="false"
                          styleClass="player-fullscreen-control-button"/>
         </HBox>

         <HBox fx:id="volumeRow"
               alignment="CENTER"
               spacing="12"
               maxWidth="Infinity"
               styleClass="player-fullscreen-volume-row">
            <StackPane fx:id="volumeIconHost"
                       minWidth="24"
                       prefWidth="24"
                       maxWidth="24"
                       styleClass="player-fullscreen-volume-icon-host"/>
            <StackPane fx:id="volumeSliderShell"
                       HBox.hgrow="ALWAYS"
                       minWidth="140"
                       prefWidth="420"
                       maxWidth="720"
                       styleClass="player-fullscreen-slider-shell">
               <Region fx:id="volumeSliderBase"
                       mouseTransparent="true"
                       StackPane.alignment="CENTER_LEFT"
                       styleClass="player-fullscreen-slider-base player-fullscreen-volume-base"/>
               <Region fx:id="volumeSliderFill"
                       mouseTransparent="true"
                       StackPane.alignment="CENTER_LEFT"
                       styleClass="player-fullscreen-slider-fill player-fullscreen-volume-fill"/>
               <Slider fx:id="volumeSlider"
                       min="0"
                       max="100"
                       value="100"
                       minWidth="140"
                       prefWidth="420"
                       maxWidth="720"
                       styleClass="player-fullscreen-slider player-fullscreen-volume-slider"/>
            </StackPane>
         </HBox>
      </VBox>
   </center>
</BorderPane>
