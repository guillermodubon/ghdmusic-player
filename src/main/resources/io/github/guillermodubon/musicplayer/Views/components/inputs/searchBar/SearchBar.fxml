<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root"
           fx:controller="io.github.guillermodubon.musicplayer.controllers.ui.components.inputs.SearchBarController"
           maxWidth="Infinity"
           stylesheets="@search-bar.css"
           styleClass="app-search-bar">
    <TextField fx:id="searchField"
               promptText="Search for whatever you want to listen to."
               maxWidth="Infinity"
               styleClass="app-search-field"/>
    <StackPane fx:id="iconHost"
               mouseTransparent="true"
               StackPane.alignment="CENTER_LEFT"
               styleClass="app-search-icon-host"/>
    <Button fx:id="clearButton"
            focusTraversable="false"
            mnemonicParsing="false"
            onAction="#onClearClicked"
            visible="false"
            managed="false"
            StackPane.alignment="CENTER_RIGHT"
            styleClass="app-search-clear-button"/>
</StackPane>
