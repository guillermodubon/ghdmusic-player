<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root"
           fx:controller="io.github.guillermodubon.musicplayer.controllers.ui.screens.playerFullScreenMode.view.PlayerFullScreenModeViewController"
           styleClass="player-full-screen-layer"
           stylesheets="@full-screen-mode.css">
    <ImageView fx:id="backgroundImageView"
               preserveRatio="true"
               smooth="true"
               styleClass="player-full-screen-background"/>
</StackPane>
