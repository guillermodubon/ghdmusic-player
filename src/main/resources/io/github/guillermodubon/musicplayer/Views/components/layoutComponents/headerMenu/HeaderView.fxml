<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.guillermodubon.musicplayer.controllers.ui.components.layoutComponents.HeaderController"
      fx:id="root"
      spacing="16"
      alignment="CENTER_LEFT"
      minHeight="76"
      prefHeight="76"
      maxWidth="Infinity"
      styleClass="app-header"
      stylesheets="@header.css">

    <padding>
        <Insets top="14" right="22" bottom="14" left="22"/>
    </padding>

    <Button fx:id="btnPrevious" onAction="#onPreviousClicked"/>
    <Button fx:id="btnNext" onAction="#onNextClicked"/>

    <Region HBox.hgrow="ALWAYS"/>

    <StackPane fx:id="searchBox"
               minWidth="320"
               prefWidth="560"
               maxWidth="760"
               HBox.hgrow="ALWAYS">
        <fx:include fx:id="searchBar"
                    source="../../inputs/searchBar/SearchBar.fxml"/>
    </StackPane>

    <Region HBox.hgrow="ALWAYS"/>

    <Button fx:id="btnDownloads" onAction="#onDownloadsClicked"/>
</HBox>
