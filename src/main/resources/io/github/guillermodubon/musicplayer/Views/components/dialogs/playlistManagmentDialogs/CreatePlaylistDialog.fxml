<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.guillermodubon.musicplayer.controllers.ui.components.dialogs.playlistManagementDialogs.CreatePlaylistDialogController"
            prefWidth="650"
            prefHeight="380"
            stylesheets="@CreatePlaylistDialog.css"
            styleClass="create-playlist-dialog">

    <fx:include fx:id="shell"
                source="../base/DialogShell.fxml"
                AnchorPane.topAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"/>

    <Button fx:id="closeButton"
            focusTraversable="false"
            onAction="#onCancel"
            styleClass="create-playlist-close-button"
            AnchorPane.topAnchor="22.0"
            AnchorPane.rightAnchor="24.0"/>
</AnchorPane>
